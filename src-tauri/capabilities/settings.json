{
  "identifier": "settings",
  "description": "Full app commands for the local settings window",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-get-stats",
    "allow-set-theme",
    "allow-set-adblock",
    "allow-update-filters",
    "allow-add-filter-list",
    "allow-remove-filter-list",
    "allow-toggle-filter-list",
    "allow-open-themes-dir",
    "allow-get-performance",
    "allow-set-performance",
    "allow-set-intro",
    "allow-set-splash",
    "allow-set-cursor",
    "allow-set-limits",
    "allow-get-limits"
  ]
}